{
    "name": "APA Scientific Report Theme",
    "version": "1.0",
    "description": "APA 7th Edition compliant theme for scientific reports",
    "page": {
        "width": 215.9,
        "height": 279.4,
        "margin_top": 25.4,
        "margin_bottom": 25.4,
        "margin_left": 25.4,
        "margin_right": 25.4,
        "page_numbering": true,
        "header_enabled": true,
        "footer_enabled": false,
        "orientation": "portrait",
        "size": "letter"
    },
    "styles": {
        "apa_title": {
            "font_family": "Times",
            "font_size": 24,
            "bold": true,
            "alignment": "center",
            "spacing_before": 20.0,
            "spacing_after": 10.0
        },
        "apa_abstract": {
            "font_family": "Times",
            "font_size": 12,
            "alignment": "left",
            "line_height": 2.0
        },
        "apa_heading": {
            "font_family": "Times",
            "font_size": 14,
            "bold": true,
            "alignment": "center",
            "spacing_before": 12.0,
            "spacing_after": 6.0
        },
        "apa_subheading": {
            "font_family": "Times",
            "font_size": 12,
            "bold": true,
            "alignment": "left",
            "spacing_before": 6.0,
            "spacing_after": 3.0
        },
        "apa_body": {
            "font_family": "Times",
            "font_size": 12,
            "alignment": "left",
            "line_height": 2.0,
            "indent": 12.7
        },
        "apa_table": {
            "font_family": "Times",
            "font_size": 10,
            "border": true,
            "border_width": 0.5,
            "padding": 3.0
        },
        "apa_table_header": {
            "font_family": "Times",
            "font_size": 10,
            "bold": true,
            "border": true,
            "border_width": 0.5,
            "padding": 3.0
        },
        "apa_figure_caption": {
            "font_family": "Times",
            "font_size": 10,
            "italic": true,
            "alignment": "left",
            "spacing_before": 4.0,
            "spacing_after": 6.0
        },
        "apa_table_caption": {
            "font_family": "Times",
            "font_size": 10,
            "italic": true,
            "alignment": "left",
            "spacing_before": 4.0,
            "spacing_after": 4.0
        },
        "apa_reference": {
            "font_family": "Times",
            "font_size": 12,
            "alignment": "left",
            "line_height": 2.0,
            "indent": 12.7
        }
    }
}
