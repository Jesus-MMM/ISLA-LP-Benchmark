{
    "name": "Default Locale Theme",
    "version": "1.0",
    "page": {
        "margin_top": 15,
        "margin_bottom": 15,
        "margin_left": 15,
        "margin_right": 15
    },
    "styles": {
        "default": {
            "font_family": "Helvetica",
            "font_size": 10,
            "line_height": 1.5
        },
        "title": {
            "font_family": "Helvetica",
            "font_size": 24,
            "bold": true,
            "alignment": "center",
            "spacing_before": 10.0,
            "spacing_after": 6.0
        },
        "subtitle": {
            "font_family": "Helvetica",
            "font_size": 16,
            "italic": true,
            "alignment": "center",
            "spacing_before": 4.0,
            "spacing_after": 8.0
        },
        "heading": {
            "font_family": "Helvetica",
            "font_size": 14,
            "bold": true,
            "spacing_before": 6.0,
            "spacing_after": 3.0
        },
        "body": {
            "font_family": "Helvetica",
            "font_size": 10,
            "line_height": 1.5,
            "spacing_after": 2.0
        },
        "caption": {
            "font_family": "Helvetica",
            "font_size": 9,
            "italic": true,
            "spacing_before": 2.0,
            "spacing_after": 4.0
        }
    }
}
